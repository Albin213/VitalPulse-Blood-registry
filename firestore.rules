rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /donors/{donorId} {
      // Donors opt in to appearing in this public directory when they register.
      allow read: if true;

      // Public registration is limited to validated donor details. Only create
      // is allowed; this app does not let visitors edit or delete donor records.
      allow create: if request.resource.data.keys().hasAll([
          'name', 'blood', 'place', 'phone', 'age', 'gender', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'blood', 'place', 'phone', 'age', 'gender', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.blood in ['O-', 'O+', 'A-', 'A+', 'B-', 'B+', 'AB-', 'AB+']
        && request.resource.data.place in [
          'Alappuzha', 'Ambalappuzha', 'Aroor', 'Aryad', 'Chambakulam',
          'Chengannur', 'Cherthala', 'Cheriyanad', 'Cheppad', 'Edathua',
          'Haripad', 'Karthikappally', 'Kayamkulam', 'Kuttanad', 'Mavelikkara',
          'Mannar', 'Mararikulam', 'Muhamma', 'Punnapra', 'Thakazhy',
          'Thalavady', 'Thiruvalla', 'Veliyanad', 'Veeyapuram'
        ]
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{10}$')
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 65
        && request.resource.data.gender in ['Female', 'Male', 'Non-binary', 'Prefer not to say']
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
